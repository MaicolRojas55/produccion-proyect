# simulado = logs + bandeja dev en la app | smtp = envío real o Mailpit local
NOTIFICATION_MODE=simulado

# Bandeja dev: API GET /dev/mailbox/* (activa por defecto en modo simulado)
DEV_MAILBOX_ENABLED=true

# --- Opción Mailpit (docker compose service "mailpit", UI http://localhost:8025) ---
# NOTIFICATION_MODE=smtp
# SMTP_SERVER=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# DEV_MAILBOX_ENABLED=false

# SERVICIO
NOTIFICATION_PORT=8002
LOG_LEVEL=info
NOTIFICATION_VERSION=0.2.0

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=tu_correo@gmail.com
SMTP_FROM_NAME=CONIITI Conference

# RABBITMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
EVENTS_EXCHANGE=coniiti.events
EVENTS_QUEUE=notifications.q

# SQLITE
SQLITE_PATH=/data/notifications.sqlite
