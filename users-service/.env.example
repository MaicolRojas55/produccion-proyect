# users-service — copiar a .env (no commitear)
# En Docker Compose muchas variables vienen del .env raíz.

MONGODB_URI=mongodb://users-mongo:27017
MONGODB_DB=users_db

JWT_SECRET_KEY=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
EVENTS_EXCHANGE=coniiti.events

LOG_LEVEL=INFO

# Crear usuarios de prueba al iniciar (false en producción)
SEED_DEFAULT_USERS=true
