# API Gateway FastAPI (opcional; en Compose se usa Nginx como gateway)
# Copiar a .env — NO commitear

BACKEND_URL=http://backend:8000
LOG_LEVEL=info

# Debe coincidir con JWT_SECRET_KEY de users-service / conferences-service (≥ 32 caracteres)
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
BACKEND_TIMEOUT=30
GATEWAY_VERSION=0.2.0
RATE_LIMIT_PER_MINUTE=100
