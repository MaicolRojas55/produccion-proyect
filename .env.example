# Variables para docker compose (raíz del monorepo)
# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
#
#   cp .env.example .env

# Secreto JWT compartido por users-service, conferences-service y back-end legacy.
# Mínimo 32 caracteres. Generar uno nuevo:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres

# RabbitMQ (credenciales del servicio rabbitmq en Compose)
RABBITMQ_USER=coniiti_mq
RABBITMQ_PASSWORD=cambiar-password-seguro
RABBITMQ_URL=amqp://coniiti_mq:cambiar-password-seguro@rabbitmq:5672/
