# back-end (monolito legacy) — copiar a .env (no commitear)
# Usar solo si ejecutas el monolito sin microservicios.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=produccion_db

JWT_SECRET_KEY=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10

# Opcional: SMTP directo desde el monolito (preferible: notification-service)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

NOTIFICATION_SERVICE_URL=http://localhost:8002

LOG_LEVEL=INFO
